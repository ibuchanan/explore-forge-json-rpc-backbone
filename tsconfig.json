{
  "compilerOptions": {
    /* Hardcoded Overrides: sourceMap is enforced by the Forge Bundler regardless of your settings */
    "jsx": "react-jsx",
    "sourceMap": true,
    "removeComments": true,

    /* Runtime baseline: Node 24; ES2022 remains a conservative target alongside the Forge Webpack defaults */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "paths": {
      "forge-ahead-rpc/webtrigger": [
        "./node_modules/forge-ahead-rpc/dist/webtrigger.d.ts"
      ]
    },
    "lib": ["ES2022"],
    "types": ["node"],

    /* Drop Calf policy defaults: enforced on update, though Forge does not force them */
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Output: The bundler handles this via a temporary directory, but 'dist' is the standard placeholder */
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
