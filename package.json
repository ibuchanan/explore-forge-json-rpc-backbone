{
  "name": "explore-forge-json-rpc-backbone",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "license": "Apache-2.0",
  "author": "your-staff-id",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
    "check": "run-p --npm-path npm --print-label lint test size:check format:check generate:commands:check generate:rpc:check",
    "clean": "rm -rf dist",
    "forge:deploy": "cmd=$(fence-rider deploy -- --non-interactive) && sh -c \"$cmd\" sh",
    "forge:install": "cmd=$(fence-rider install -- --confirm-scopes --non-interactive) && sh -c \"$cmd\" sh",
    "forge:register": "forge register",
    "forge:uninstall": "cmd=$(fence-rider uninstall) && sh -c \"$cmd\" sh",
    "forge:upgrade": "cmd=$(fence-rider install -- --upgrade --confirm-scopes --non-interactive) && sh -c \"$cmd\" sh",
    "forge:variables:set": "fence-rider variables",
    "forge:webtrigger:upsert": "secretspec run --scope '' -- sh scripts/upsert-webtrigger.sh",
    "format": "biome format --write",
    "format:check": "biome format",
    "generate:commands": "node --experimental-strip-types scripts/generate-commands.ts",
    "generate:commands:check": "node --experimental-strip-types scripts/generate-commands.ts --check",
    "lint": "run-p --npm-path npm --print-label \"lint:check:*\"",
    "lint:check:biome": "biome lint",
    "lint:check:forge": "cmd=$(fence-rider lint) && sh -c \"$cmd\" sh",
    "lint:check:format": "npm run format:check",
    "lint:check:prelint": "ast-grep scan --globs '!specs/**' --globs '!node_modules/**' --config ./node_modules/@forge-ahead/prelint/sgconfig.ecosol.yml",
    "lint:check:typecheck": "npm run typecheck",
    "lint:docs": "markdownlint-cli2 \"**/*.md\" && cspell lint \"**/*.md\"",
    "lint:fix": "biome lint --write",
    "prepare": "lefthook install || true",
    "size:check": "npm run build && size-limit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:deployed": "secretspec run --scope '' -- sh scripts/test-deployed.sh",
    "test:watch": "vitest watch --passWithNoTests",
    "todo": "git grep -n -I -F TO\"DO\" -- .; status=$?; if [ \"$status\" -eq 1 ]; then echo \"No TO\"\"DO markers found.\"; elif [ \"$status\" -ne 0 ]; then exit \"$status\"; fi",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "generate:rpc": "bun run scripts/generate-rpc.ts generate",
    "generate:rpc:check": "bun run scripts/generate-rpc.ts check"
  },
  "dependencies": {
    "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types",
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    "@forge-ahead/triggers": "github:ibuchanan/forge-ahead-triggers",
    "@forge/api": "^8.3",
    "@forge/bridge": "^7.2",
    "@forge/kvs": "^2.1",
    "@forge/react": "^12.3",
    "@forge/resolver": "^2.0",
    "forge-ahead-rpc": "file:../forge-ahead-rpc",
    "json-rpc-2.0": "^1.8",
    "react": "^18.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51",
    "@biomejs/biome": "2.6.2",
    "@forge-ahead/prelint": "github:ibuchanan/tool-forge-prelint-ast-grep",
    "@forge/events": "3.0.8",
    "@open-rpc/meta-schema": "^1.14",
    "@open-rpc/typings": "1.13.1",
    "@size-limit/file": "^14.3",
    "@types/node": "24",
    "@types/react": "^18.3",
    "@types/react-test-renderer": "^18.3",
    "@vitest/coverage-v8": "^5.0",
    "ajv": "^8.20",
    "ajv-formats": "^3.0",
    "cspell": "^10.4",
    "esbuild": "^0.27.7",
    "fast-check": "^4.10",
    "fence-rider": "github:ibuchanan/ranch-rig-fence-rider",
    "git-cliff": "^2.14",
    "json-schema-to-typescript": "16.0.0",
    "lefthook": "^2.2",
    "markdownlint-cli2": "^0.24",
    "npm-run-all2": "^9.0",
    "react-test-renderer": "^18.3",
    "size-limit": "^14.3",
    "typescript": "^5.9",
    "vitest": "^5.0"
  },
  "size-limit": [
    {
      "name": "Forge app bundle",
      "path": "dist/**/*.js",
      "limit": "16 kB"
    }
  ]
}
